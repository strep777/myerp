# 复制为 .env 后按需修改；不要提交真实密钥
# 生产环境请生成并填写随机 SECRET_KEY：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# 仅首次建库创建 admin 时使用；部署后立即在系统内修改
ADMIN_INITIAL_PASSWORD=Admin@12345

# HTTPS 部署必须设为 true
COOKIE_SECURE=false

# 生产建议 false，关闭 /api/docs
ENABLE_DOCS=false

APP_TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO

# 首次建库是否写入演示商品、仓库和往来单位
SEED_DEMO_DATA=true

# Ubuntu Docker Compose 映射到宿主机的端口
APP_PORT=8000
