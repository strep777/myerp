# 只给镜像构建发送必需文件，减少上下文与网络传输。
.git
.gitignore
.venv
venv
.pnpm-store
.pytest_cache
__pycache__
*.py[cod]
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
data
backups
doc
.ui-test
.env
.env.*
*.md
debug.log
mock-ai-ready.txt

# 前端只保留已构建的 dist；源码/依赖不进入镜像上下文
frontend/node_modules
frontend/src
frontend/.vite
frontend/coverage

# 后端测试与缓存不进入镜像
backend/.pytest_cache
backend/tests
